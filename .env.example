# Copy to .env and keep it private. Do not commit the completed file.

# Local Tuya LAN connection. The inspected device requires protocol 3.4.
TUYA_DEVICE_ID=replace-with-private-device-id
# Keep the local key quoted: an unquoted # is parsed as a comment by dotenv.
TUYA_LOCAL_KEY="replace-with-private-local-key"
TUYA_HOST=replace-with-private-lan-hostname
TUYA_VERSION=3.4
TUYA_PORT=6668

# Safety gate: leave BOTH variables unset to disable close control.
# Set both only after independent physical validation of the close mapping for
# this exact device. TUYA_CLOSE_VALUE must be valid JSON.
# TUYA_CLOSE_DPS=
# TUYA_CLOSE_VALUE=
